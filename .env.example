# Project-level Docker Compose environment example.
# EN: Copy this file to .env in the project root and adjust deployment options.
# ES: Copia este archivo como .env en la raíz del proyecto y ajusta las opciones de despliegue.
# ZH: 将此文件复制为项目根目录下的 .env，并按部署方式调整配置。
#
# EN: Backend application secrets stay in Backend/backend-api/.env.
# ES: Los secretos propios del backend permanecen en Backend/backend-api/.env.
# ZH: 后端应用自身的密钥仍然放在 Backend/backend-api/.env。
# -----------------------------------------------------------------------------
# Compose profiles / optional services
# -----------------------------------------------------------------------------

# EN: Optional Compose services to start.
#     postgres starts PostgreSQL 17 and imports Base_de_datos SQL files.
#     redis starts two Redis containers: one for cache and one for BullMQ.
#     cloudflared starts the Cloudflare Tunnel service.
# ES: Servicios opcionales de Compose que se iniciarán.
#     postgres inicia PostgreSQL 17 e importa los SQL de Base_de_datos.
#     redis inicia dos contenedores Redis: uno para caché y otro para BullMQ.
#     cloudflared inicia el servicio Cloudflare Tunnel.
# ZH: 要启动的可选 Compose 服务。
#     postgres 会启动 PostgreSQL 17 并导入 Base_de_datos 目录下的 SQL 文件。
#     redis 会启动两个 Redis 容器：一个用于缓存，一个用于 BullMQ。
#     cloudflared 会启动 Cloudflare Tunnel 服务。
COMPOSE_PROFILES=postgres,redis

# -----------------------------------------------------------------------------
# Backend runtime
# -----------------------------------------------------------------------------

# EN: Backend process mode. Supported values: single, cluster, pm2.
# ES: Modo de proceso del backend. Valores soportados: single, cluster, pm2.
# ZH: 后端进程模式。支持的值：single、cluster、pm2。
MAIAN_BACKEND_MODE=single

# EN: Node.js runtime environment inside the backend container.
# ES: Entorno de ejecución de Node.js dentro del contenedor backend.
# ZH: 后端容器内的 Node.js 运行环境。
MAIAN_NODE_ENV=production

# EN: Host port exposed on your machine for the backend API.
# ES: Puerto del host expuesto en tu máquina para la API del backend.
# ZH: 宿主机上暴露给后端 API 的端口。
MAIAN_API_HOST_PORT=3000

# EN: Internal port used by the backend container.
# ES: Puerto interno utilizado por el contenedor backend.
# ZH: 后端容器内部使用的端口。
MAIAN_API_CONTAINER_PORT=3000

# EN: PM2 instance count when MAIAN_BACKEND_MODE=pm2. Use a number or max.
# ES: Número de instancias PM2 cuando MAIAN_BACKEND_MODE=pm2. Usa un número o max.
# ZH: 当 MAIAN_BACKEND_MODE=pm2 时的 PM2 实例数。可使用数字或 max。
MAIAN_PM2_INSTANCES=max

# EN: Native Node cluster worker count when MAIAN_BACKEND_MODE=cluster.
# ES: Número de workers del cluster nativo de Node cuando MAIAN_BACKEND_MODE=cluster.
# ZH: 当 MAIAN_BACKEND_MODE=cluster 时的 Node 原生 cluster worker 数量。
MAIAN_CLUSTER_INSTANCES=3

# EN: Upload directory path inside the backend container.
# ES: Ruta del directorio de subidas dentro del contenedor backend.
# ZH: 后端容器内部的上传文件目录。
MAIAN_FILE_UPLOAD_DIR=uploads

# -----------------------------------------------------------------------------
# Local PostgreSQL 17
# -----------------------------------------------------------------------------

# EN: Database name created by the local PostgreSQL container.
# ES: Nombre de la base de datos creada por el contenedor local de PostgreSQL.
# ZH: 本地 PostgreSQL 容器创建的数据库名称。
MAIAN_POSTGRES_DB=maian

# EN: PostgreSQL user created for the local database.
# ES: Usuario PostgreSQL creado para la base de datos local.
# ZH: 为本地数据库创建的 PostgreSQL 用户。
MAIAN_POSTGRES_USER=maian

# EN: PostgreSQL password for the local database. Change it before production use.
# ES: Contraseña PostgreSQL para la base de datos local. Cámbiala antes de producción.
# ZH: 本地数据库的 PostgreSQL 密码。生产环境使用前请修改。
MAIAN_POSTGRES_PASSWORD=maian_dev_password

# EN: Host port exposed on your machine for PostgreSQL.
# ES: Puerto del host expuesto en tu máquina para PostgreSQL.
# ZH: 宿主机上暴露给 PostgreSQL 的端口。
MAIAN_POSTGRES_HOST_PORT=5432

# EN: External PostgreSQL URL used by the running backend API.
#     Uncomment this and remove postgres from COMPOSE_PROFILES when using Supabase or another managed PostgreSQL.
# ES: URL externa de PostgreSQL usada por la API backend en ejecución.
#     Descoméntala y elimina postgres de COMPOSE_PROFILES si usas Supabase u otro PostgreSQL gestionado.
# ZH: 后端运行时使用的外部 PostgreSQL 连接串。
#     如果使用 Supabase 或其他托管 PostgreSQL，请取消注释并从 COMPOSE_PROFILES 中移除 postgres。
# MAIAN_DATABASE_URL=postgresql://user:password@host:5432/maian?schema=public

# EN: Direct PostgreSQL URL used by database tooling. It can be the same as MAIAN_DATABASE_URL.
# ES: URL directa de PostgreSQL usada por herramientas de base de datos. Puede ser igual a MAIAN_DATABASE_URL.
# ZH: 数据库工具使用的直连 PostgreSQL 连接串。可以与 MAIAN_DATABASE_URL 相同。
# MAIAN_DIRECT_URL=postgresql://user:password@host:5432/maian?schema=public

# -----------------------------------------------------------------------------
# Local Redis
# -----------------------------------------------------------------------------

# EN: Host port exposed for the Redis instance dedicated to cache/session/rate-limit data.
# ES: Puerto del host para la instancia Redis dedicada a caché/sesiones/rate-limit.
# ZH: 用于缓存、会话和限流的 Redis 实例在宿主机暴露的端口。
MAIAN_REDIS_CACHE_HOST_PORT=6379

# EN: Host port exposed for the Redis instance dedicated to BullMQ queues.
# ES: Puerto del host para la instancia Redis dedicada a las colas BullMQ.
# ZH: 用于 BullMQ 队列的 Redis 实例在宿主机暴露的端口。
MAIAN_REDIS_BULL_HOST_PORT=6380

# EN: External Redis URL for application cache. Uncomment and remove redis from COMPOSE_PROFILES when using external Redis.
# ES: URL externa de Redis para caché de aplicación. Descoméntala y elimina redis de COMPOSE_PROFILES si usas Redis externo.
# ZH: 应用缓存使用的外部 Redis 连接串。如果使用外部 Redis，请取消注释并从 COMPOSE_PROFILES 中移除 redis。
# MAIAN_REDIS_CACHE_URL=redis://cache-host:6379

# EN: External Redis URL for BullMQ queues. Uncomment and remove redis from COMPOSE_PROFILES when using external Redis.
# ES: URL externa de Redis para colas BullMQ. Descoméntala y elimina redis de COMPOSE_PROFILES si usas Redis externo.
# ZH: BullMQ 队列使用的外部 Redis 连接串。如果使用外部 Redis，请取消注释并从 COMPOSE_PROFILES 中移除 redis。
# MAIAN_REDIS_BULL_URL=redis://bull-host:6379

# -----------------------------------------------------------------------------
# Cloudflared
# -----------------------------------------------------------------------------

# EN: Add cloudflared to COMPOSE_PROFILES to start the tunnel service.
#     Place cloudflared/<TUNNEL_ID>.json next to cloudflared/config.yml.
# ES: Añade cloudflared a COMPOSE_PROFILES para iniciar el servicio de túnel.
#     Coloca cloudflared/<TUNNEL_ID>.json junto a cloudflared/config.yml.
# ZH: 将 cloudflared 加入 COMPOSE_PROFILES 即可启动隧道服务。
#     请把 cloudflared/<TUNNEL_ID>.json 放在 cloudflared/config.yml 旁边。
# COMPOSE_PROFILES=postgres,redis,cloudflared

# EN: Cloudflare Tunnel ID used by the cloudflared service.
# ES: ID del túnel de Cloudflare utilizado por el servicio cloudflared.
# ZH: cloudflared 服务使用的 Cloudflare Tunnel ID。
# TUNNEL_ID=your-tunnel-id

# EN: Host port exposed for cloudflared metrics.
# ES: Puerto del host expuesto para las métricas de cloudflared.
# ZH: cloudflared metrics 在宿主机暴露的端口。
MAIAN_CLOUDFLARED_METRICS_PORT=2000
