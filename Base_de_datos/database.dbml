Enum "AddressType" {
  "DELIVERY"
  "INVOICE"
  "STORE"
}

Enum "DeliveryStatus" {
  "PENDING"
  "IN_PROGRESS"
  "COMPLETED"
}

Enum "OrderStatus" {
  "PENDING"
  "ACCEPTED"
  "REJECTED"
  "CANCELLED"
}

Enum "ProductStatus" {
  "ACTIVE"
  "INACTIVE"
}

Enum "SaleVariant" {
  "UNIT"
  "BOX"
  "PACK"
}

Enum "UserRole" {
  "WHOLESALER"
  "RETAILER"
  "SUPPORT"
  "DELIVERY"
  "WAREHOUSE"
  "ADMIN"
  "SUPERADMIN"
}

Enum "UserStatus" {
  "PENDING_VERIFICATION"
  "INACTIVE"
  "ACTIVE"
  "PENDING_REVIEW"
  "APPROVED"
  "BANNED"
}

Table "categories" {
  "id" int8 [pk, not null, increment]
  "user_id" uuid [note: '如果未空则代表为公共']
  "name" varchar(50) [not null, note: '名字']
  "iva" numeric(5,2) [check: `(iva >= (0)::numeric) AND (iva <= (100)::numeric)`]
  "parent_id" int8
  "created_at" timestamptz [not null, default: `now()`]
  "level" int2 [not null, check: `(level >= 1) AND (level <= 3)`, note: '嵌套层级，最多三层即1->2->3']
  "name_unaccent" text
  "updated_at" timestamptz [default: `now()`]
  "created_by" uuid
  "updated_by" uuid
  "version" int8 [not null, default: 1]
  "deleted_at" timestamptz

  Indexes {
    (level, id) [type: btree, name: "idx_categories_level_id"]
    (parent_id, id) [type: btree, name: "idx_categories_parent_id_id"]
    (parent_id, level, name) [type: btree, name: "idx_categories_public_parent_level_name_all"]
    (user_id, parent_id, level, name) [type: btree, name: "idx_categories_user_parent_level_name"]
  }
  Note: '类别分为公共和私人 / categorías son públicos o privados'
}

Table "chat_panels" {
  "id" int8 [pk, not null, increment]
  "name" varchar(50) [not null]
  "created_at" timestamptz [not null, default: `now()`]
  Note: '聊天界面或会话 / Sesión de Chat'
}

Table "chat_participants" {
  "user_id" uuid [not null]
  "chat_panel_id" int8 [not null]
  "created_at" timestamptz [default: `now()`]

  Indexes {
    (chat_panel_id, user_id) [pk, type: btree, name: "chat_participants_pkey"]
  }
  Note: '连接用户和聊天会话 / Conectar usuarios y charlas'
}

Table "configurations" {
  "user_id" uuid [pk, not null]
  "language" varchar(10) [not null, default: 'en', note: 'BCP-47 Code']
  "timezone" varchar(32) [not null, default: 'UTC', note: 'IANA时区名字']
}

Table "deliveries" {
  "id" int8 [pk, not null, increment]
  "order_id" int8 [not null]
  "delivery_person" uuid
  "status" DeliveryStatus [not null, default: 'PENDING', note: '0=等待配送， 1=正在配送， 2=配送完成']
  "start_time" timestamptz [not null, default: `now()`, note: '开始时间']
  "end_time" timestamptz [default: `now()`, note: '结束时间']
  "notes" text [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [default: `now()`]
  "latitude" float8 [not null]
  "longitude" float8 [not null]
  Note: '送货表'
}

Table "delivery_timeline" {
  "id" int8 [pk, not null, increment]
  "delivery_id" int8
  "status" DeliveryStatus [not null, note: '0=等待配送， 1=正在配送， 2=配送完成']
  "notes" text
  "created_at" timestamptz [not null, default: `now()`]
  "latitude" float8 [not null]
  "longitude" float8 [not null]
  Note: '配送时间线'
}

Table "discounts" {
  "id" int8 [pk, not null, increment]
  "user_id" uuid [not null]
  "name" varchar [not null]
  "type_value" jsonb [not null, note: '先做：减百分比，满金额减少固定金额，满金额减少百分比']
  "applies_to_all" bool [not null, default: false, note: '是否给其名下所有的产品']
  "start_date" date [not null]
  "end_date" date [not null]
  "status" int2 [not null, default: '1']
  "created_at" timestamptz [not null, default: `now()`]
  Note: '折扣'
}

Table "files" {
  "id" int8 [pk, not null, increment]
  "file_name" varchar [not null, check: `(file_name)::text ~* '^[^\\/:\*\?"<>\|]{1,255}\.[a-z0-9]+$'::text`]
  "file_hash" varchar(64) [unique, not null]
  "mime_type" varchar(128) [not null]
  "file_size" int8 [not null]
  "storage_key" text [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "to_delete" bool [not null, default: false]
  "cloud_synced" bool [not null, default: true]

  Indexes {
    (to_delete, created_at, id) [type: btree, name: "idx_files_cleanup_mark"]
    created_at [type: btree, name: "idx_files_created_at"]
    id [type: btree, name: "idx_files_sync_cloud_false"]
    id [type: btree, name: "idx_files_sync_cloud_true"]
  }
  Note: '保存文件url (储存在云端) / guardar url de los archivos'
}

Table "message_files" {
  "id" int8 [pk, not null, increment]
  "message_id" int8 [not null]
  "file_id" int8 [not null]
  "sort" int2 [not null]

  Indexes {
    file_id [type: btree, name: "idx_message_files_file_id"]
  }
  Note: '消息文件，音频，视频，视频 / los archivos de los mensajes'
}

Table "messages" {
  "id" int8 [pk, not null, increment]
  "chat_panel_id" int8 [not null]
  "sender_id" uuid [default: '00000000-0000-0000-0000-000000000000', note: '0代表发送者被删除都是还有人看消息所以保留消息']
  "reply_to" int8 [default: '-1', note: '-1代表引用的消息被删除']
  "content" text
  "created_at" timestamptz [not null, default: `now()`]
  "is_read" bool [not null, default: false]
  Note: '聊天信息 / mensajes de chat'
}

Table "notifications" {
  "id" int8 [pk, not null, increment]
  "user_id" uuid [not null]
  "title" varchar(100) [not null]
  "message" text [not null]
  "type" int2 [not null, note: '还不确定，应该有多种比如消息通知，减价，库存。。。']
  "is_read" bool [not null, default: false]
  "click_action" varchar(255) [not null, note: '导航到位置']
  "created_at" timestamptz [not null, default: `now()`]
}

Table "products" {
  "id" int8 [pk, not null, increment]
  "user_id" uuid [not null]
  "name" varchar(50) [not null]
  "title" varchar(100)
  "description" text
  "iva" numeric(5,2) [not null, check: `(iva >= (0)::numeric) AND (iva <= (100)::numeric)`]
  "status" ProductStatus [not null, default: 'ACTIVE', note: '1=activo, 0=desactivo']
  "created_at" timestamptz [not null, default: `now()`]
  "product_code" varchar(50) [not null]
  "updated_at" timestamptz [default: `now()`]
  "created_by" uuid
  "updated_by" uuid
  "name_unaccent" text
  "title_unaccent" text
  "version" int8 [not null, default: 1]
  "deleted_at" timestamptz

  Indexes {
    name_unaccent [type: gin, name: "idx_products_name_unaccent_trgm_new"]
    product_code [type: gin, name: "idx_products_product_code_trgm"]
    (status, id) [type: btree, name: "idx_products_status_id"]
    title_unaccent [type: gin, name: "idx_products_title_unaccent_trgm_new"]
    (user_id, id) [type: btree, name: "idx_products_user_id_id"]
    (user_id, status, id) [type: btree, name: "idx_products_user_status_id"]
  }
  Note: '产品基础表 / valor basica de productos'
}

Table "products_files" {
  "id" int8 [pk, not null, increment]
  "product_id" int8 [not null]
  "file_id" int8 [not null]
  "sort" int2 [not null]

  Indexes {
    file_id [type: btree, name: "idx_products_files_file_id"]
    (product_id, sort, file_id) [type: btree, name: "idx_products_files_product_sort_file"]
  }
  Note: '产品的宣传图什么的'
}

Table "user_sessions" {
  "session_id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "user_id" uuid [not null]
  "device_name" varchar(150) [not null]
  "device_finger" varchar(255) [not null]
  "user_agent" text [not null]
  "revoked" bool [not null, default: false]
  "last_ip" varchar(50) [not null]
  "refresh_token" text
  "created_at" timestamptz [not null, default: `now()`]
  "last_active" timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, device_finger) [type: btree, unique, name: "unique_device_finger_user"]
    user_id [type: btree, name: "idx_user_sessions_active_user"]
    last_active [type: btree, name: "idx_user_sessions_last_active"]
    (user_id, last_active) [type: btree, name: "idx_user_sessions_user_last_active"]
  }
}

Table "users" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "user_id" text [unique]
  "first_name" varchar(50)
  "last_name" varchar(60)
  "username" varchar(50) [unique]
  "password" text [not null]
  "email" varchar(255) [unique, not null]
  "telephone" varchar(25)
  "status" UserStatus [not null, default: 'PENDING_VERIFICATION']
  "profile" jsonb
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [default: `now()`]
  "role" UserRole [not null, note: '0 → wholesaler  批发商即本平台的商店，1 → retailer  零售商 2 → support  客服  3 → 送货员  5 → 货物管理员']
  "tax_id" varchar(20) [note: '税号']
  "updated_by" uuid
  "profile_image_file_id" int8

  Indexes {
    profile_image_file_id [type: btree, name: "idx_users_profile_image_file_id"]
    (role, status, created_at, id) [type: btree, name: "idx_users_role_status_created_at"]
    (role, tax_id) [type: btree, name: "idx_users_role_tax_id"]
    id [type: btree, name: "idx_users_wholesaler_active_id"]
    (id, `lower(COALESCE((profile ->> 'display_name'::text)`, ` (profile ->> 'company_name'::text)))`) [type: btree, name: "idx_users_wholesaler_visible_sort"]
  }
  Note: '用户表'
}

Table "variant_products" {
  "id" int8 [pk, not null, increment]
  "created_at" timestamptz [not null, default: `now()`]
  "product_id" int8 [not null]
  "type_sale" SaleVariant [not null, note: '销售变体类型，分别为散卖，按包，按箱。']
  "price" numeric(14,6) [not null, check: `(price >= (0)::numeric) AND (price <= 10000000.00)`]
  "price_iva" numeric(14,6) [not null, check: `(price_iva >= (0)::numeric) AND (price_iva <= 20000000.00)`]
  "available_stock" int4 [not null, check: `available_stock >= 0`, note: '实际可供销售和发货的可用库存数量。']
  "sort" int2 [not null, check: `sort >= 0`]
  "attributes" jsonb
  "status" ProductStatus [not null, default: 'ACTIVE']
  "product_code" varchar(50) [not null]
  "reserved_stock" int4 [not null, check: `reserved_stock >= 0`, default: 0, note: '已下单但尚未发货的预留库存数量，避免超卖。']
  "low_stock_threshold" int4 [not null, check: `low_stock_threshold >= 0`, default: 0, note: '触发低库存预警的阈值。当可用库存低于此值时，向分销商发送通知。']
  "sale_unit_qty" int4 [not null, check: `(sale_unit_qty >= 1) AND (sale_unit_qty <= 1000000)`, default: 1, note: '一个销售单位（如：一箱、一包）所包含的最小库存单位数量。']
  "min_order_qty" int4 [not null, check: `(min_order_qty >= 1) AND (min_order_qty <= 1000000)`, default: 1, note: '最小订购数量（以销售单位计）。']
  "updated_at" timestamptz [default: `now()`]
  "created_by" uuid
  "updated_by" uuid

  Indexes {
    product_code [type: gin, name: "idx_variant_products_product_code_trgm"]
    (product_id, price_iva) [type: btree, name: "idx_variant_products_product_id_price_iva"]
    (product_id, status, id) [type: btree, name: "idx_variant_products_product_status"]
  }
  Note: '变体销售配置'
}

Table "verification_tokens" {
  "id" uuid [pk, not null, default: `uuid_generate_v4()`]
  "user_id" uuid [not null]
  "token" varchar(255) [not null]
  "expires_at" timestamptz [not null, default: `now()`]
  "is_used" bool [not null, default: false]
  "created_at" timestamptz [not null, default: `now()`]
  "attempts" int2 [not null, default: 0]

  Indexes {
    expires_at [type: btree, name: "idx_verification_tokens_cleanup_expired"]
    id [type: btree, name: "idx_verification_tokens_cleanup_used"]
    (user_id, expires_at, created_at) [type: btree, name: "idx_verification_tokens_user_unused_expires_created"]
    (user_id, created_at) [type: btree, name: "idx_verification_tokens_user_unused_recent"]
    (user_id, token) [type: btree, name: "verification_tokens_user_id_token_idx"]
  }
}

Table "countries" {
  "iso_alpha2" bpchar(2) [unique, not null, note: 'ISO 3166-1 alpha-2 国家代码，两位字符']
  "iso_alpha3" bpchar(3) [unique, not null, note: 'ISO 3166-1 alpha-3 国家代码，三位字符']
  "iso_numeric" int2 [pk, not null, note: 'ISO 3166-1 数字代码']
  "name" varchar(100) [not null, note: '国家英文官方名称']
  "name_local" varchar(100) [not null, note: '国家本地语言名称']
  "currency_id" int2 [note: '使用的货币']
}

Table "provinces" {
  "id" int4 [pk, not null, increment]
  "country_iso" int2 [not null, note: '所属国家 iso numeric，外键关联 countries 表']
  "name" varchar(100) [not null, note: '省份/州的英文名称']
  "name_local" varchar(100) [not null, note: '省份/州的本地名称']

  Indexes {
    (id, country_iso) [type: btree, unique, name: "provinces_id_country_unique"]
    (country_iso, name) [type: btree, name: "idx_provinces_country_iso_name"]
  }
}

Table "cities" {
  "id" int4 [pk, not null, increment]
  "province_id" int4 [not null, note: '所属省份 ID，外键关联 provinces 表']
  "name" varchar(100) [not null, note: '城市英文名称']
  "name_local" varchar(100) [not null, note: '城市本地名称']

  Indexes {
    (id, province_id) [type: btree, unique, name: "cities_id_province_unique"]
    (province_id, name) [type: btree, name: "idx_cities_province_id_name"]
  }
}

Table "directions" {
  "id" int8 [pk, not null, increment]
  "user_id" uuid [not null]
  "type" AddressType [not null, default: 'STORE', note: '地址类型']
  "country_iso" int2 [not null]
  "province_id" int4 [not null]
  "city_id" int4 [not null]
  "street" varchar(200) [not null]
  "zip_code" varchar(10) [not null]
  "latitude" float8
  "longitude" float8
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [default: `now()`]

  Indexes {
    (user_id, type, id) [type: btree, name: "idx_directions_user_type_id"]
  }
}

Table "currencies" {
  "iso_numeric" int2 [pk, not null]
  "iso_alpha3" bpchar(3) [unique, not null]
  "symbol" varchar(5) [not null]
  "decimal_digits" int2 [not null]
}

Table "product_categories" {
  "product_id" int8 [unique, not null]
  "category_id" int8 [not null]
  "is_primary" bool [not null, default: false, note: '标记该关联是否为产品的主分类。']

  Indexes {
    (product_id, category_id) [pk, type: btree, name: "product_categories_pkey"]
    (category_id, product_id) [type: btree, name: "idx_product_categories_category_product"]
    product_id [type: btree, name: "idx_product_categories_product_id"]
  }
  Note: '产品与分类的关联表，支持多对多关系。'
}

Table "category_translations" {
  "category_id" int8 [not null]
  "lang_code" varchar(10) [not null]
  "name" varchar(50) [not null]
  "name_unaccent" text
  "created_at" timestamptz [default: `now()`]
  "updated_at" timestamptz [default: `now()`]
  "updated_by" uuid

  Indexes {
    (category_id, lang_code) [pk, type: btree, name: "pk_category_translations"]
    lang_code [type: btree, name: "idx_category_translations_lang_code"]
    name_unaccent [type: gin, name: "idx_category_translations_name_unaccent_trgm"]
  }
}

Table "product_translations" {
  "product_id" int8 [not null]
  "lang_code" varchar(10) [not null]
  "name" varchar(50) [not null]
  "title" varchar(100)
  "description" text
  "name_unaccent" text
  "title_unaccent" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [default: `now()`]
  "updated_by" uuid

  Indexes {
    (product_id, lang_code) [pk, type: btree, name: "pk_product_translations"]
    name_unaccent [type: gin, name: "idx_product_translations_name_unaccent_trgm"]
    title_unaccent [type: gin, name: "idx_product_translations_title_unaccent_trgm"]
  }
}

Table "user_uploads" {
  "user_id" uuid [not null]
  "file_id" int8 [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (user_id, file_id) [pk, type: btree, name: "user_uploads_pkey"]
    (file_id, user_id) [type: btree, name: "idx_user_uploads_file_user"]
  }
}

Table "carts" {
  "id" int8 [pk, not null, increment]
  "retailer_id" uuid [not null]
  "wholesaler_id" uuid [not null]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [default: `now()`]

  Checks {
    `retailer_id <> wholesaler_id` [name: 'carts_user_wholesaler_different']
  }

  Indexes {
    (retailer_id, wholesaler_id) [type: btree, unique, name: "carts_user_wholesaler_unique"]
    (retailer_id, updated_at, id) [type: btree, name: "idx_carts_retailer_updated_at"]
    wholesaler_id [type: btree, name: "idx_carts_wholesaler_id"]
  }
}

Table "cart_details" {
  "id" int8 [pk, not null, increment]
  "cart_id" int8 [not null]
  "variant_products_id" int8 [not null]
  "quantity" int4 [not null, check: `(quantity >= 1) AND (quantity <= 1000000)`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [default: `now()`]

  Indexes {
    (cart_id, variant_products_id) [type: btree, unique, name: "cart_details_cart_variant_unique"]
    (cart_id, updated_at, id) [type: btree, name: "idx_cart_details_cart_updated_at"]
    variant_products_id [type: btree, name: "idx_cart_details_variant_products_id"]
  }
}

Table "document_sequences" {
  "owner_id" uuid [not null]
  "document_type" varchar(10) [not null]
  "year" int2 [not null, check: `(year >= 2000) AND (year <= 9999)`]
  "current_value" int4 [not null, check: `current_value >= 0`, default: 0]

  Indexes {
    (owner_id, document_type, year) [pk, type: btree, name: "document_sequences_pkey"]
  }
}

Table "orders" {
  "id" int8 [pk, not null, increment]
  "order_series" varchar(10) [not null, default: 'PED']
  "order_year" int2 [not null, check: `(order_year >= 2000) AND (order_year <= 9999)`]
  "order_sequence" int4 [not null, check: `order_sequence >= 1`]
  "order_number" varchar(40) [not null]
  "retailer_id" uuid
  "wholesaler_id" uuid
  "status" OrderStatus [not null, default: 'PENDING']
  "currency" bpchar(3) [not null, default: 'EUR']
  "subtotal" numeric(20,2) [not null]
  "discount_total" numeric(20,2) [not null, default: 0]
  "iva_total" numeric(20,2) [not null]
  "total" numeric(20,2) [not null]
  "item_count" int4 [not null, check: `item_count >= 1`]
  "shipping_address_snapshot" jsonb [not null]
  "retailer_snapshot" jsonb [not null]
  "wholesaler_snapshot" jsonb [not null]
  "accepted_at" timestamptz
  "accepted_by" uuid
  "rejected_at" timestamptz
  "rejected_by" uuid
  "rejected_reason" varchar(500)
  "cancelled_at" timestamptz
  "estimated_delivery_date" timestamptz
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [default: `now()`]
  "cancelled_by" uuid
  "cancelled_reason" varchar(500)

  Checks {
    `(retailer_id IS NULL) OR (wholesaler_id IS NULL) OR (retailer_id <> wholesaler_id)` [name: 'orders_retailer_wholesaler_different']
    `(status <> 'REJECTED'::"OrderStatus") OR (rejected_reason IS NOT NULL)` [name: 'orders_rejected_reason_check']
    `(subtotal >= (0)::numeric) AND (discount_total >= (0)::numeric) AND (iva_total >= (0)::numeric) AND (total >= (0)::numeric)` [name: 'orders_amounts_check']
  }

  Indexes {
    (wholesaler_id, order_number) [type: btree, unique, name: "orders_wholesaler_order_number_unique"]
    (wholesaler_id, order_series, order_year, order_sequence) [type: btree, unique, name: "orders_wholesaler_series_year_sequence_unique"]
    id [type: btree, name: "idx_orders_accepted_id"]
    order_number [type: gin, name: "idx_orders_order_number_trgm"]
    (retailer_id, created_at) [type: btree, name: "idx_orders_retailer_created_at"]
    (retailer_id, status, created_at) [type: btree, name: "idx_orders_retailer_status_created_at"]
    (retailer_id, wholesaler_id, created_at) [type: btree, name: "idx_orders_retailer_wholesaler_created_at"]
    (wholesaler_id, created_at) [type: btree, name: "idx_orders_wholesaler_accepted_created_at"]
    (wholesaler_id, created_at) [type: btree, name: "idx_orders_wholesaler_created_at"]
    (wholesaler_id, status, created_at) [type: btree, name: "idx_orders_wholesaler_status_created_at"]
  }
}

Table "order_details" {
  "id" int8 [pk, not null, increment]
  "order_id" int8 [not null]
  "product_id" int8
  "variant_product_id" int8
  "product_name" varchar(100) [not null]
  "product_title" varchar(150)
  "product_code" varchar(50) [not null]
  "variant_product_code" varchar(50) [not null]
  "product_translations_snapshot" jsonb [not null, default: `[]`]
  "variant_attributes_snapshot" jsonb [not null, default: `{}`]
  "type_sale" SaleVariant [not null]
  "sale_unit_qty" int4 [not null, check: `sale_unit_qty >= 1`]
  "quantity" int4 [not null, check: `quantity >= 1`]
  "unit_price" numeric(14,6) [not null]
  "unit_price_iva" numeric(14,6) [not null]
  "iva" numeric(5,2) [not null]
  "subtotal" numeric(20,2) [not null]
  "iva_total" numeric(20,2) [not null]
  "total" numeric(20,2) [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `(unit_price >= (0)::numeric) AND (unit_price_iva >= (0)::numeric) AND (iva >= (0)::numeric) AND (iva <= (100)::numeric) AND (subtotal >= (0)::numeric) AND (iva_total >= (0)::numeric) AND (total >= (0)::numeric)` [name: 'order_details_amounts_check']
  }

  Indexes {
    order_id [type: btree, name: "idx_order_details_order_id"]
    (order_id, product_id, quantity) [type: btree, name: "idx_order_details_order_product_qty_not_null"]
    product_id [type: btree, name: "idx_order_details_product_id"]
    variant_product_id [type: btree, name: "idx_order_details_variant_product_id"]
  }
}

Table "order_pdf_files" {
  "order_id" int8 [not null]
  "lang_code" varchar(10) [not null]
  "file_id" int8 [not null]
  "created_at" timestamptz [not null, default: `now()`]

  Indexes {
    (order_id, file_id) [pk, type: btree, name: "order_pdf_files_pkey"]
    (order_id, lang_code) [type: btree, unique, name: "order_pdf_files_order_lang_unique"]
    file_id [type: btree, name: "idx_order_pdf_files_file_id"]
  }
}

Table "wholesaler_staffs" {
  "id" int8 [pk, not null, increment]
  "wholesaler_id" uuid [not null]
  "staff_user_id" uuid [not null]
  "role" UserRole [not null, check: `role = ANY (ARRAY['SUPPORT'::"UserRole", 'DELIVERY'::"UserRole", 'WAREHOUSE'::"UserRole"])`]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [default: `now()`]
  "created_by" uuid
  "updated_by" uuid

  Checks {
    `wholesaler_id <> staff_user_id` [name: 'chk_wholesaler_staff_not_self']
  }

  Indexes {
    (wholesaler_id, staff_user_id) [type: btree, unique, name: "uq_wholesaler_staff"]
    staff_user_id [type: btree, name: "idx_wholesaler_staffs_staff_user_id"]
    wholesaler_id [type: btree, name: "idx_wholesaler_staffs_wholesaler_id"]
    (wholesaler_id, role) [type: btree, name: "idx_wholesaler_staffs_wholesaler_role"]
  }
}

