{
  "name": "backend-api",
  "version": "0.0.1",
  "description": "",
  "author": "Dsqrwym",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "imports": {
    "#/*": "./dist/src/*"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "cross-env NODE_ENV=production node dist/src/main.js",
    "start:cluster": "node dist/src/cluster-main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "ts-patch install",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:start:prod": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop maian-backend",
    "pm2:restart": "pm2 restart maian-backend",
    "pm2:reload": "pm2 reload maian-backend",
    "pm2:delete": "pm2 delete maian-backend",
    "pm2:logs": "pm2 logs maian-backend --lines 60",
    "pm2:dev": "pnpm build && pnpm pm2:start",
    "pm2:prod": "pnpm build && pnpm pm2:start:prod"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
