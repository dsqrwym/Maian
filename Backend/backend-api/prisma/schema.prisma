model categories {
  id                    BigInt                  @id @default(autoincrement())
  user_id               String?                 @db.Uuid
  name                  String                  @db.VarChar(50)
  iva                   Decimal?                @db.Decimal(5, 2)
  parent_id             BigInt?
  created_at            DateTime                @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamp(6)
  level                 Int                     @db.SmallInt
  name_unaccent         String?                 @default(dbgenerated("immutable_unaccent((name)::text)"))
  parent                categories?             @relation("CategoryParent", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children              categories[]            @relation("CategoryParent")
  users                 users?                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category_translations category_translations[]
  product_categories    product_categories[]

  @@schema("public")
}

