# Backend API environment example.
# Copy this file to .env and replace placeholders with real values.
# EN: Do not commit real secrets.
# ES: No subas secretos reales al repositorio.
# ZH: 不要把真实密钥提交到仓库。

# -----------------------------------------------------------------------------
# Runtime / process
# -----------------------------------------------------------------------------

# EN: HTTP port used by the Nest/Fastify server.
# ES: Puerto HTTP usado por el servidor Nest/Fastify.
# ZH: Nest/Fastify 后端服务监听的 HTTP 端口。
PORT=3000

# EN: Runtime mode. Use "development" locally and "production" in production.
# ES: Modo de ejecucion. Usa "development" en local y "production" en produccion.
# ZH: 运行环境。本地使用 "development"，生产环境使用 "production"。
NODE_ENV=development

# EN: PM2 process count. Use a number or "max"; defaults to CPU count minus one.
# ES: Numero de procesos de PM2. Usa un numero o "max"; por defecto es CPU menos uno.
# ZH: PM2 进程数量。可填写数字或 "max"，默认约为 CPU 核心数减一。
PM2_INSTANCES=3

# EN: Worker process count for src/cluster-main.ts; defaults to CPU count minus one.
# ES: Numero de procesos worker para src/cluster-main.ts; por defecto es CPU menos uno.
# ZH: src/cluster-main.ts 使用的 worker 进程数量，默认约为 CPU 核心数减一。
CLUSTER_INSTANCES=3

# -----------------------------------------------------------------------------
# Super admin bootstrap
# -----------------------------------------------------------------------------

# EN: Email used when the app creates the initial SUPERADMIN account.
# ES: Email usado cuando la app crea la cuenta SUPERADMIN inicial.
# ZH: 应用初始化创建 SUPERADMIN 账号时使用的邮箱。
SUPERADMIN_EMAIL=superadmin@example.com

# EN: Username seed for the initial SUPERADMIN account.
# ES: Nombre de usuario base para la cuenta SUPERADMIN inicial.
# ZH: 初始 SUPERADMIN 账号的用户名基础值。
SUPERADMIN_USERNAME=superadmin

# EN: Password for the initial SUPERADMIN account. Change it before production.
# ES: Contrasena de la cuenta SUPERADMIN inicial. Cambiala antes de produccion.
# ZH: 初始 SUPERADMIN 账号密码，生产环境前必须修改。
SUPERADMIN_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Database / migrations
# -----------------------------------------------------------------------------

# EN: PostgreSQL connection string used by the running API.
# ES: Cadena de conexion PostgreSQL usada por la API en ejecucion.
# ZH: 后端运行时使用的 PostgreSQL 数据库连接字符串。
DATABASE_URL="postgresql://username:password@host:5432/database?schema=public"

# EN: Direct PostgreSQL connection string used by drizzle.config.ts for migrations/introspection.
# ES: Conexion directa de PostgreSQL usada por drizzle.config.ts para migraciones/introspeccion.
# ZH: drizzle.config.ts 迁移/反向生成结构时使用的直连数据库地址。
DIRECT_URL="postgresql://username:password@host:5432/database?schema=public"

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# EN: Redis URL used for application cache, sessions, rate limiting, and video token checks.
# ES: URL de Redis usada para cache, sesiones, rate limiting y tokens de video.
# ZH: 应用缓存、会话、限流和视频播放 token 校验使用的 Redis 地址。
REDIS_CACHE_URL="redis://localhost:6379"

# EN: Redis URL used by BullMQ mail queues.
# ES: URL de Redis usada por las colas de correo BullMQ.
# ZH: BullMQ 邮件队列使用的 Redis 地址。
REDIS_BULL_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# Auth / security
# -----------------------------------------------------------------------------

# EN: Secret used to sign and verify normal access/refresh JWTs.
# ES: Secreto usado para firmar y verificar JWT normales de acceso/refresh.
# ZH: 用于签发和验证普通 access/refresh JWT 的密钥。
AUTH_JWT_SECRET=replace-with-a-long-random-secret

# EN: Secret used by CSRF tokens for refresh-token web flows.
# ES: Secreto usado por los tokens CSRF en flujos web de refresh token.
# ZH: refresh-token Web 流程中 CSRF token 使用的密钥。
CSRF_TOKEN_SECRET=replace-with-a-long-random-secret

# EN: Secret used by signed cookies through @fastify/cookie.
# ES: Secreto usado para cookies firmadas mediante @fastify/cookie.
# ZH: @fastify/cookie 签名 Cookie 使用的密钥。
COOKIE_SECRET=replace-with-a-long-random-secret

# EN: Secret reserved for mail-related JWTs; defined in constants/local env but not used by current source code.
# ES: Secreto reservado para JWT relacionados con correo; definido pero no usado por el codigo actual.
# ZH: 邮件相关 JWT 的预留密钥；当前源码未读取。
MAIL_JWT_SECRET=replace-with-a-long-random-secret

# EN: JWT access token lifetime in seconds.
# ES: Duracion del access token JWT en segundos.
# ZH: JWT access token 有效期，单位秒。
ACCESS_TOKEN_EXPIRES_IN=600

# EN: Refresh token lifetime in seconds. Default in code is 259200 seconds.
# ES: Duracion del refresh token en segundos. El valor por defecto en codigo es 259200 segundos.
# ZH: refresh token 有效期，单位秒。代码默认值为 259200 秒。
REFRESH_TOKEN_EXPIRES_IN=259200

# EN: Maximum active sessions/devices allowed per user.
# ES: Numero maximo de sesiones/dispositivos activos permitidos por usuario.
# ZH: 每个用户允许同时存在的最大活跃会话/设备数量。
MAX_SESSIONS_PER_USER=3

# EN: Maximum failed login attempts before locking the account.
# ES: Numero maximo de intentos fallidos antes de bloquear la cuenta.
# ZH: 账号被锁定前允许的最大登录失败次数。
LOGIN_MAX_ATTEMPTS=3

# EN: Account lock duration after too many failed logins, in minutes.
# ES: Duracion del bloqueo tras demasiados fallos de login, en minutos.
# ZH: 登录失败次数过多后的账号锁定时长，单位分钟。
LOGIN_LOCK_MINUTES=15

# EN: bcrypt salt rounds for password hashing. Higher is safer but slower.
# ES: Rondas de salt de bcrypt para hashear contrasenas. Mas alto es mas seguro pero mas lento.
# ZH: bcrypt 密码哈希的 salt rounds，越高越安全但越慢。
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# Worker pool
# -----------------------------------------------------------------------------

# EN: Maximum Piscina worker threads for hash tasks; defaults to CPU count minus one.
# ES: Maximo de hilos Piscina para tareas de hash; por defecto es CPU menos uno.
# ZH: 哈希任务 Piscina 线程池最大线程数，默认约为 CPU 核心数减一。
WORKER_POOL_MAX_THREADS=3

# EN: Worker idle timeout in milliseconds.
# ES: Tiempo de inactividad del worker en milisegundos.
# ZH: worker 空闲超时时间，单位毫秒。
WORKER_POOL_IDLE_TIMEOUT=60000

# EN: Concurrent tasks allowed per worker thread.
# ES: Tareas concurrentes permitidas por cada hilo worker.
# ZH: 每个 worker 线程允许并发执行的任务数。
WORKER_POOL_CONCURRENT_TASKS=2

# -----------------------------------------------------------------------------
# Files / storage
# -----------------------------------------------------------------------------

# EN: Local directory for uploaded files when local storage or sync fallback is used.
# ES: Directorio local para archivos subidos cuando se usa almacenamiento local o fallback de sincronizacion.
# ZH: 本地存储或同步回退模式下的上传文件目录。
FILE_UPLOAD_DIR=uploads

# EN: File sync switch. When true and R2 is configured, writes local plus cloud with fallback.
# ES: Interruptor de sincronizacion. Si es true y R2 esta configurado, escribe local y nube con fallback.
# ZH: 文件同步开关。为 true 且 R2 配置完整时，会本地+云端双写并支持回退。
FILE_SYNC_ENABLED=false

# EN: Reserved storage driver selector; current driver selection is based on R2 settings and FILE_SYNC_ENABLED.
# ES: Selector reservado de almacenamiento; la seleccion actual depende de R2 y FILE_SYNC_ENABLED.
# ZH: 存储驱动选择预留项；当前实际选择逻辑基于 R2 配置和 FILE_SYNC_ENABLED。
STORAGE_TYPE=local

# EN: Cloudflare R2 bucket name for object storage.
# ES: Nombre del bucket Cloudflare R2 para almacenamiento de objetos.
# ZH: Cloudflare R2 对象存储桶名称。
R2_BUCKET_NAME=your-r2-bucket

# EN: Cloudflare R2 S3-compatible endpoint URL.
# ES: URL del endpoint compatible con S3 de Cloudflare R2.
# ZH: Cloudflare R2 的 S3 兼容 endpoint 地址。
R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com

# EN: Cloudflare R2 access key ID.
# ES: ID de clave de acceso de Cloudflare R2.
# ZH: Cloudflare R2 的 access key ID。
R2_ACCESS_KEY_ID=your-r2-access-key-id

# EN: Cloudflare R2 secret access key.
# ES: Clave secreta de acceso de Cloudflare R2.
# ZH: Cloudflare R2 的 secret access key。
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# EN: Secret for short-lived video playback JWTs.
# ES: Secreto para JWT temporales de reproduccion de video.
# ZH: 短期视频播放 JWT 使用的签名密钥。
VIDEO_PLAY_TOKEN_SECRET=replace-with-a-long-random-secret

# EN: Video playback token lifetime in seconds. Default in code is 1800 seconds.
# ES: Duracion del token de reproduccion de video en segundos. El valor por defecto en codigo es 1800 segundos.
# ZH: 视频播放 token 有效期，单位秒。代码默认值为 1800 秒。
VIDEO_PLAY_TOKEN_TTL=1800

# -----------------------------------------------------------------------------
# Mail / queues
# -----------------------------------------------------------------------------

# EN: SMTP server host used by the mail module.
# ES: Host del servidor SMTP usado por el modulo de correo.
# ZH: 邮件模块使用的 SMTP 服务器主机。
SMTP_HOST=smtp.example.com

# EN: SMTP server port. 587 is commonly used for STARTTLS.
# ES: Puerto del servidor SMTP. 587 se usa comunmente para STARTTLS.
# ZH: SMTP 服务器端口，587 通常用于 STARTTLS。
SMTP_PORT=587

# EN: SMTP username.
# ES: Usuario SMTP.
# ZH: SMTP 用户名。
SMTP_USER=your-smtp-user

# EN: SMTP password or app password.
# ES: Contrasena SMTP o contrasena de aplicacion.
# ZH: SMTP 密码或应用专用密码。
SMTP_PASS=your-smtp-password

# EN: Default sender email address.
# ES: Email remitente por defecto.
# ZH: 默认发件人邮箱地址。
FROM_EMAIL=noreply@example.com

# EN: Number of retry attempts for queued email jobs.
# ES: Numero de reintentos para trabajos de correo en cola.
# ZH: 邮件队列任务失败后的重试次数。
SMTP_RETRIES=3

# EN: Delay between email retry attempts in milliseconds.
# ES: Retraso entre reintentos de correo en milisegundos.
# ZH: 邮件重试之间的延迟时间，单位毫秒。
SMTP_DELAY_TIME=60000

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

# EN: Rate-limit time window in seconds.
# ES: Ventana de rate limit en segundos.
# ZH: 限流时间窗口，单位秒。
THROTTLER_TTL=60

# EN: Maximum requests allowed per rate-limit window.
# ES: Maximo de solicitudes permitidas por ventana de rate limit.
# ZH: 每个限流窗口允许的最大请求数。
THROTTLER_LIMIT=100

# -----------------------------------------------------------------------------
# Product / cart / order limits
# -----------------------------------------------------------------------------

# EN: Maximum image files allowed per product.
# ES: Maximo de imagenes permitidas por producto.
# ZH: 每个产品允许的最大图片数量。
PRODUCT_MAX_IMAGES=10

# EN: Maximum video files allowed per product.
# ES: Maximo de videos permitidos por producto.
# ZH: 每个产品允许的最大视频数量。
PRODUCT_MAX_VIDEOS=1

# EN: Maximum document files allowed per product.
# ES: Maximo de documentos permitidos por producto.
# ZH: 每个产品允许的最大文档数量。
PRODUCT_MAX_DOCUMENTS=5

# EN: Maximum variants allowed per product.
# ES: Maximo de variantes permitidas por producto.
# ZH: 每个产品允许的最大变体数量。
PRODUCT_MAX_VARIANTS=50

# EN: Maximum sub-categories allowed per product.
# ES: Maximo de subcategorias permitidas por producto.
# ZH: 每个产品允许关联的最大子分类数量。
PRODUCT_MAX_SUB_CATEGORIES=10

# EN: Maximum wholesaler carts a retailer can keep open.
# ES: Maximo de carritos por mayorista que un minorista puede mantener abiertos.
# ZH: 每个零售商可同时保留的批发商购物车最大数量。
CART_MAX_WHOLESALERS_PER_RETAILER=20

# EN: Maximum line items allowed in one cart.
# ES: Maximo de lineas permitidas en un carrito.
# ZH: 单个购物车允许的最大商品行数。
CART_MAX_LINES_PER_CART=250

# EN: Maximum line items allowed in one order.
# ES: Maximo de lineas permitidas en un pedido.
# ZH: 单个订单允许的最大商品行数。
ORDER_MAX_LINES=250

# EN: Maximum split search terms used by list/search endpoints.
# ES: Maximo de terminos de busqueda separados usados por endpoints de listado/busqueda.
# ZH: 列表/搜索接口最多使用的拆分搜索关键词数量。
MAX_SEARCH_TERMS=10
